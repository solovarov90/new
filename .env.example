# Скопируйте в .env и заполните. Комментарии пишите только на отдельных строках:
# systemd не обрезает текст после значения.

# --- Telegram ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Группа из ссылки t.me/c/3990082908/... — к номеру добавляется -100.
TELEGRAM_CHAT_ID=-1003990082908
# Ваш Telegram ID. Напишите /id в группе, бот ответит числом.
OWNER_ID=

# --- Notion ---
# Секрет внутренней интеграции Notion с доступом к странице «Выздоровление: программа АА».
NOTION_TOKEN=
NOTION_DB_INVENTORY=293dd5b343814c1a91611fd947bf1fe2
NOTION_DB_JOURNAL=f8088db012484b60b3b6c9c789302c14
NOTION_DB_PEOPLE=b23abdb01ae54d49873043585e2d3fbf
NOTION_DB_PRAYERS=7d101f1c547041ddb2ebaa88a93ac13b
NOTION_DB_PRACTICES=6b154e9d2f42461d9bb7ca13dd61bf76
NOTION_DB_CHECKIN=f0a868c9111c421ebd76ddf3f72e4275

# --- Gemini: расшифровка голосовых и разбор ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Расписание ---
TIMEZONE=Asia/Ho_Chi_Minh
MORNING_TIME=06:30
EVENING_TIME=22:30
SOBRIETY_DATE=2026-06-15
# Имя и телефон спонсора для сообщения SOS (необязательно).
SPONSOR_CONTACT=

# --- Служебное ---
SYNC_INTERVAL=60
STATE_PATH=/opt/aa-bot/state.db

# Привязать бота к уже существующей теме вместо создания новой (необязательно).
# Ключи: MORNING, PRAYERS, PEOPLE, REVIEW, INVENTORY, PRACTICES, EVENING, SOS.
# TOPIC_REVIEW=2
